<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="20dp"
    android:paddingVertical="12dp">

    <!-- Avatar -->
    <TextView
        android:id="@+id/tvPeerAvatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@color/secondary"
        android:gravity="center"
        android:text="B"
        android:textColor="@color/on_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvPeerDisplayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tvChatTime"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Bob Builder"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="12:45 PM"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvPeerUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@bob"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvLastMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tvUnreadBadge"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Latest message preview..."
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvUnreadBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_alignParentEnd="true"
                android:background="@color/primary"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/on_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </RelativeLayout>

    </LinearLayout>
</LinearLayout>
